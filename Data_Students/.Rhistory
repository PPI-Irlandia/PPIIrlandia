tmap_mode("plot")
map <- Ireland %>%
tm_shape() +
tm_fill(col = "Freq",
palette = "YlOrRd",
title = "Distribution",
text.size = 0.5,
style = "cont",
position = c("top", "left")) +
tm_scale_bar(breaks = c(0, 50, 100), text.size = 0.5,
position = c("right", "bottom")) +
tm_layout(frame = FALSE,
main.title = "Students Distribution by Geographical Location",
main.title.size = 1)
print(map)
data_summary <- data %>%
mutate(AgeRange = cut(
Age,
breaks = seq(15, max(Age, na.rm = TRUE) + 5, by = 5),
right = TRUE,
include.lowest = TRUE,
labels = paste(seq(15, max(Age, na.rm = TRUE), by = 5),
seq(19, max(Age, na.rm = TRUE) + 4, by = 5),
sep = "-")
)) %>%
count(AgeRange)
# Plot
plot_ly(data = data_summary,
x = ~AgeRange,
y = ~n,
type = 'bar',
marker = list(
color = ~n,
colorscale = "Plasma"
),
text = ~paste(n),
hoverinfo = 'text') %>%
layout(title = "Age Distribution",
xaxis = list(title = "Age Range", tickangle = -45),
yaxis = list(title = "Count"),
bargap = 0.2,
plot_bgcolor = "#ffffff",
paper_bgcolor = "#ffffff")
